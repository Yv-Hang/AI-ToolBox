<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.aitoolbox.mapper.LoginMapper">
    
    <insert id="addUser" parameterType="com.example.aitoolbox.entity.User">
        INSERT INTO user (id, username, email, password, status, created_at, updated_at)
        VALUES (#{id}, #{username}, #{email}, #{password}, #{status}, NOW(), NOW())
    </insert>
    
    <select id="getUserByEmail" parameterType="String" resultType="com.example.aitoolbox.entity.User">
        SELECT * FROM user WHERE email = #{email}
    </select>
    
    <select id="getUserByUsername" parameterType="String" resultType="com.example.aitoolbox.entity.User">
        SELECT * FROM user WHERE username = #{username}
    </select>
    
    <select id="selectById" parameterType="Long" resultType="com.example.aitoolbox.entity.User">
        SELECT * FROM user WHERE id = #{id}
    </select>
    
</mapper>